# Copy this file to `.env` and fill in your values.
# The PUBLIC_ prefix is REQUIRED so Astro exposes them to the browser.
#
# NOTE: these still ship in the client JS (they must, for a static site).
# The anon key is public by design — your data is protected by RLS, not by
# hiding this. Never put the service_role key here.
PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key
