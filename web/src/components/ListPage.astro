---
// The web list page, shared by animelist.html and mangalist.html. Both read
// and write the SAME list (one localStorage key, one cloud row); `type` only
// decides which entries this page shows and how it words them. The behaviour
// lives in public/js/animelist.js, which reads `data-list-type` off the root.
import SiteHeader from './SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';

interface Props {
  type: 'anime' | 'manga';
}
const { type } = Astro.props;
const manga = type === 'manga';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const site = import.meta.env.SITE.replace(/\/$/, '');
const page = manga ? 'mangalist' : 'animelist';

const t = manga
  ? {
      title: 'Manga List, your reading list in the browser',
      description:
        'Track the manga, manhwa and manhua you read with OtakuList — chapters, ratings and status. Stored in your browser and synced with the extension.',
      heading: 'Manga List',
      intro: 'Track every manga, manhwa and manhua you read — chapters, ratings and status — right here in your browser.',
      active: 'Reading',
      plan: 'Plan to Read',
      unit: 'chapter',
      titleHint: 'e.g. Solo Leveling',
      siteLabel: 'Where you read (optional)',
      siteHint: 'e.g. mangadex.org',
    }
  : {
      title: 'Anime List, your watchlist in the browser',
      description:
        'A web version of your OtakuList anime watchlist — track episodes, ratings and status. Stored in your browser and synced with the extension.',
      heading: 'Anime List',
      intro: 'Track every show, episode, rating and status right here in your browser.',
      active: 'Watching',
      plan: 'Plan to Watch',
      unit: 'episode',
      titleHint: 'e.g. Jujutsu Kaisen',
      siteLabel: 'Where you watch (optional)',
      siteHint: 'e.g. aniwatch.to',
    };

const theme =
  "--color-bg:#0b0a16;--color-surface:#17142a;--color-text:#f4f2f8;" +
  "--color-accent:#7d5cf5;--color-accent-2:#6fa8dc;--color-accent-600:#6b4be0;" +
  "--color-divider:rgba(255,255,255,.12);--glass-line:rgba(255,255,255,.08);" +
  "--shadow-md:0 8px 24px rgba(0,0,0,.45);--shadow-lg:0 26px 60px rgba(0,0,0,.6);" +
  "--font-heading:'Archivo',system-ui,sans-serif;--font-body:'Poppins',system-ui,sans-serif;" +
  "--font-display:'Archivo',system-ui,sans-serif;" +
  "min-height:100vh;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body)";
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonical={`${site}${base}${page}.html`}
  page="animelist"
  chrome={false}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />

  <div style={theme} data-list-type={type}>
    <!-- header -->
    <SiteHeader active={page}>
      <Fragment slot="actions">
        <span id="al-cloud-status" class="text-xs text-[#f4f2f8]/50" aria-live="polite"></span>
        <button id="al-export" type="button" class="cursor-pointer rounded-full border border-solid border-white/[.12] bg-transparent px-[18px] py-2.5 font-heading text-sm font-extrabold text-[#f4f2f8]">Export</button>
        <button id="al-import" type="button" class="cursor-pointer rounded-full border border-solid border-white/[.12] bg-transparent px-[18px] py-2.5 font-heading text-sm font-extrabold text-[#f4f2f8]">Import</button>
        <input id="al-importfile" type="file" accept="application/json,.json" hidden />
        <button id="al-quickbtn" type="button" class="cursor-pointer rounded-full border border-solid border-iris/50 bg-iris/15 px-[18px] py-2.5 font-heading text-sm font-extrabold text-[#e7e2ff]" title="Paste a link to an episode or chapter">🔗 Paste link</button>
        <button id="al-add" type="button" class="cursor-pointer rounded-full border-none bg-iris px-5 py-2.5 font-heading text-sm font-extrabold text-white">＋ Add {manga ? 'manga' : 'anime'}</button>
      </Fragment>
    </SiteHeader>

    <!-- hero -->
    <section class="border-b border-white/[.075]">
      <div class="mx-auto max-w-[1320px] px-7 pb-[30px] pt-11">
        <div class="mb-3 text-[11.5px] uppercase tracking-[.16em] text-iris-2">Your list</div>
        <h1 class="m-0 mb-2.5 font-heading text-[clamp(30px,4vw,48px)] font-extrabold tracking-[-.035em]">{t.heading}</h1>
        <p class="m-0 max-w-[64ch] text-base text-[#f4f2f8]/[.62]">{t.intro} It stays on your device, and you can move it to and from the extension any time with <b class="text-iris-2">Export / Import</b>.</p>
      </div>
    </section>

    <!-- toolbar -->
    <div class="mx-auto max-w-[1320px] px-7 pt-[22px]">
      <!-- anime / manga: separate pages over the one list -->
      <nav id="al-kinds" class="al-kinds" aria-label="Anime or manga">
        <a class:list={['al-kind', { on: !manga }]} data-type="anime" href={`${base}animelist.html`} aria-current={manga ? undefined : 'page'}>🎬 Anime <span class="n">0</span></a>
        <a class:list={['al-kind', { on: manga }]} data-type="manga" href={`${base}mangalist.html`} aria-current={manga ? 'page' : undefined}>📖 Manga <span class="n">0</span></a>
      </nav>
      <div class="al-toolbar">
        <div id="al-tabs" class="al-tabs">
          <button class="al-tab on" data-status="watching" type="button">{t.active} <span class="n">0</span></button>
          <button class="al-tab" data-status="plan" type="button">Plan <span class="n">0</span></button>
          <button class="al-tab" data-status="completed" type="button">Completed <span class="n">0</span></button>
          <button class="al-tab" data-status="onhold" type="button">On Hold <span class="n">0</span></button>
        </div>
        <div class="al-tools">
          <div class="al-searchwrap">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(244,242,248,.45)" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <input id="al-search" type="text" placeholder="Search titles…" />
          </div>
          <select id="al-sort" class="al-select">
            <option value="updated">Recently updated</option>
            <option value="added">Recently added</option>
            <option value="title">Title A–Z</option>
            <option value="episode">Most {t.unit}s</option>
          </select>
          <div id="al-view" class="al-view">
            <button class="al-vbtn on" data-view="grid" type="button" title="Grid view" aria-label="Grid view">▦</button>
            <button class="al-vbtn" data-view="list" type="button" title="List view" aria-label="List view">≣</button>
          </div>
        </div>
      </div>
      <div id="al-count" class="mx-0.5 mt-3.5 text-[12.5px] text-[#f4f2f8]/[.45]">0 titles saved</div>
    </div>

    <!-- cards -->
    <div class="mx-auto max-w-[1320px] px-7 pb-20 pt-5">
      <div id="al-grid" class="al-grid"></div>
      <div id="al-empty" class="al-empty" hidden></div>
    </div>

    <Footer />

    <!-- quick add: paste a link / arrive from the share sheet (see animelist.js) -->
    <div id="al-quick" class="am-overlay" hidden>
      <div class="am-card aq-card">
        <button class="am-x" id="aq-close" type="button" aria-label="Close">✕</button>
        <h2 class="am-title">Quick add</h2>
        <label class="am-label" for="aq-paste">Paste a link or title</label>
        <textarea id="aq-paste" class="am-in aq-paste" rows="2" placeholder="https://…/solo-leveling/chapter-110"></textarea>

        <div class="aq-types" role="group" aria-label="Anime or manga">
          <button type="button" class="aq-type" data-type="anime">🎬 Anime</button>
          <button type="button" class="aq-type" data-type="manga">📖 Manga</button>
        </div>

        <div class="flex gap-3">
          <div class="flex-[3]">
            <label class="am-label" for="aq-title">Title</label>
            <input id="aq-title" class="am-in" type="text" placeholder="Title" />
          </div>
          <div class="flex-1">
            <label class="am-label" for="aq-progress" id="aq-unit">Episode</label>
            <input id="aq-progress" class="am-in" type="number" min="0" step="any" placeholder="–" />
          </div>
        </div>

        <div class="am-label">Pick the right one</div>
        <div id="aq-results" class="aq-results"></div>

        <div class="aq-actions">
          <button id="aq-plan" type="button" class="aq-btn aq-ghost">＋ Plan to watch</button>
          <button id="aq-save" type="button" class="aq-btn">▶ Watching</button>
        </div>
      </div>
    </div>

    <!-- add modal -->
    <div id="al-modal" class="am-overlay" hidden>
      <div class="am-card">
        <button class="am-x" id="al-modal-close" type="button" aria-label="Close">✕</button>
        <h2 class="am-title">Add {manga ? 'manga' : 'anime'}</h2>
        <form id="al-form" class="am-form">
          {manga ? (
            <>
              <label class="am-label" for="al-f-type">Type</label>
              <select id="al-f-type" class="am-in">
                <option value="manga">Manga</option>
                <option value="manhwa">Manhwa</option>
                <option value="manhua">Manhua</option>
                <option value="novel">Light Novel</option>
              </select>
            </>
          ) : (
            <input id="al-f-type" type="hidden" value="anime" />
          )}

          <label class="am-label" for="al-f-title">Title</label>
          <input id="al-f-title" class="am-in" type="text" placeholder={t.titleHint} required />

          <label class="am-label" for="al-f-status">Status</label>
          <select id="al-f-status" class="am-in">
            <option value="watching">{t.active}</option>
            <option value="plan">{t.plan}</option>
            <option value="completed">Completed</option>
            <option value="onhold">On Hold</option>
          </select>

          <div class="flex gap-3">
            <div class="flex-1">
              <label class="am-label" for="al-f-ep">Current {t.unit}</label>
              <input id="al-f-ep" class="am-in" type="number" min="0" step="any" placeholder="0" />
            </div>
            <div class="flex-1">
              <label class="am-label" for="al-f-total">Total {t.unit}s</label>
              <input id="al-f-total" class="am-in" type="number" min="0" placeholder="?" />
            </div>
          </div>

          <label class="am-label" for="al-f-cover">Cover image URL (optional)</label>
          <input id="al-f-cover" class="am-in" type="url" placeholder="https://…" />

          <label class="am-label" for="al-f-site">{t.siteLabel}</label>
          <input id="al-f-site" class="am-in" type="text" placeholder={t.siteHint} />

          <button type="submit" class="am-submit">Add to list</button>
        </form>
      </div>
    </div>
  </div>

  <Fragment slot="scripts">
    <script is:inline src={`${base}js/animelist.js`}></script>
  </Fragment>
</BaseLayout>
