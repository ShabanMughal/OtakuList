---
// The one site footer. BaseLayout renders it on pages with chrome, and the
// pages that draw their own chrome (home, list, import, showcase) include it
// directly, so a page never needs to add it twice.
//
// It sets its own background, font, line-height, link colour and border style
// rather than inheriting them: the home page loads redesign.css (purple links)
// and the rest load global.css (inherited links), and Tailwind's preflight is
// off, so a bare `border-t` draws nothing. Spelling it all out here is what
// keeps it identical everywhere.
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const REPO = 'https://github.com/ShabanMughal/OtakuList';
const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { href: `${base}#features`, label: 'Features' },
      { href: `${base}#how`, label: 'How it works' },
      { href: `${base}#install`, label: 'Install' },
      { href: `${base}#faq`, label: 'FAQ' },
    ],
  },
  {
    title: 'App',
    links: [
      { href: `${base}animelist.html`, label: 'Create list' },
      { href: `${base}import.html`, label: 'Import tool' },
      { href: `${base}showcase.html`, label: 'Gacha Profiles' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { href: REPO, label: 'GitHub repo', external: true },
      { href: `${REPO}/issues`, label: 'Report an issue', external: true },
      { href: `${REPO}/blob/main/LICENSE`, label: 'MIT license', external: true },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: `${base}privacy-policy.html`, label: 'Privacy Policy' },
      { href: `${base}contact.html`, label: 'Contact' },
    ],
  },
];
---

<footer class="site-footer relative z-[1] border-0 border-t border-solid border-white/[.075] bg-[#0b0a16] font-body text-[#f4f2f8]">
  <div class="mx-auto box-border grid max-w-[1320px] gap-9 px-4 pb-10 pt-14 sm:px-7" style="grid-template-columns:repeat(auto-fit,minmax(170px,1fr))">
    <div>
      <a href={base} class="mb-3.5 flex items-center gap-2.5">
        <span class="grid h-7 w-7 flex-none place-items-center rounded-full border border-solid border-white/[.14] bg-[#191531]"><img src={`${base}assets/gojo.png`} alt="" class="block h-[25px] w-[25px] rounded-full object-cover" /></span>
        <span class="font-heading text-[17px] font-extrabold text-[#f4f2f8]">OtakuList</span>
      </a>
      <p class="m-0 max-w-[30ch] text-[13.5px] text-[#f4f2f8]/50">A watchlist that belongs to your browser, not to a website.</p>
    </div>
    {columns.map((col) => (
      <nav aria-label={col.title}>
        <div class="mb-3.5 text-[11px] font-semibold uppercase tracking-[.14em] text-[#f4f2f8]/[.45]">{col.title}</div>
        <div class="flex flex-col gap-[9px] text-sm">
          {col.links.map((l) => (
            <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
          ))}
        </div>
      </nav>
    ))}
  </div>
  <div class="mx-auto box-border flex max-w-[1320px] flex-wrap items-center justify-between gap-4 border-0 border-t border-solid border-white/[.075] px-4 pb-10 pt-[18px] text-[12.5px] text-[#f4f2f8]/40 sm:px-7">
    <span>© {year} OtakuList · No ads, no tracking. Logging in is optional.</span>
    <span>OtakuList does not host or link to any video content.</span>
  </div>
</footer>

<style is:global>
  .site-footer {
    line-height: 1.55;
  }
  .site-footer a {
    color: rgba(244, 242, 248, 0.7);
    text-decoration: none;
  }
  .site-footer a:hover {
    color: #b9a8ff;
  }
</style>
