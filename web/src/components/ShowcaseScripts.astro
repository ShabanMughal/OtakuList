---
// Bootstraps web/public/js/showcase.js. Shared by showcase.html and the
// generated per-profile pages so the two never fall out of step.
//
// `profileUser` is set only on a per-profile page: showcase.js reads it when
// there is no ?u= in the query string, which is how u/<name>.html shows a
// profile without changing the old link format.
const { profileUser = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<script is:inline define:vars={{ base, profileUser }}>
  // window.sb (the Supabase client) is created by AuthBootstrap in the layout.

  // The site root ("/"). Profile pages live one directory deeper than
  // showcase.html, so the script cannot derive it from location.pathname.
  window.GS_BASE = base;
  window.GS_PROFILE_USER = profileUser || null;
</script>
<script is:inline src={`${base}js/showcase.js`}></script>
