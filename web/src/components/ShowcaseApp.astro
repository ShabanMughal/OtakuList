---
import SiteHeader from './SiteHeader.astro';
// The whole Gacha Showcase UI — gallery, editor, profile view and auth modal.
//
// Shared by showcase.html and the generated per-profile pages (u/<name>.html)
// so both serve the identical DOM that web/public/js/showcase.js drives. The
// script looks up its elements unconditionally at load, so a page that dropped
// half of this markup would break it; reusing the component is what keeps the
// two routes from drifting apart.
//
// `profile` is set only on a generated per-profile page. When it is, the
// profile view is the one that renders server-side and the explore view starts
// hidden — the reverse of showcase.html. showcase.js then re-renders the
// profile from the live row, which is also how a page for a since-deleted
// profile ends up showing "Showcase not found" instead of stale content.
import Footer from './Footer.astro';
import StaticProfile from './StaticProfile.astro';

const { profile = null, roster = {} } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const isProfilePage = !!profile;

// modernist theme tokens, scoped to this page's wrapper
const theme =
  "--color-bg:#0b0a16;--color-surface:#17142a;--color-text:#f4f2f8;" +
  "--color-accent:#7d5cf5;--color-accent-2:#6fa8dc;--color-accent-600:#6b4be0;" +
  "--color-divider:rgba(255,255,255,.12);--glass-line:rgba(255,255,255,.08);" +
  "--shadow-md:0 8px 24px rgba(0,0,0,.45);--shadow-lg:0 26px 60px rgba(0,0,0,.6);" +
  "--font-heading:'Archivo',system-ui,sans-serif;--font-body:'Poppins',system-ui,sans-serif;" +
  "--font-display:'Archivo',system-ui,sans-serif;" +
  "min-height:100vh;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body)";
---

<div style={theme}>
  <!-- ═══════════ header ═══════════ -->
  <SiteHeader active="showcase" />

  <div id="auth-msg" class="gs-auth-msg mx-auto mt-3.5 max-w-[1320px] px-7" hidden></div>

  <!-- one-time notice for profiles whose photo was adopted automatically -->
  <div id="gs-photo-notice" hidden class="mx-auto mt-3.5 flex max-w-[1320px] flex-wrap items-center gap-3 rounded-[14px] border border-iris/[.35] bg-iris/10 px-[18px] py-3 text-[13.5px] text-[#cbb8ff]">
    <span class="flex-1 min-w-[260px]">
      Your profile picture is the photo from the account you signed in with, and your profile is public.
      Earlier versions set this automatically — you can switch to a character portrait instead.
    </span>
    <button id="gs-photo-swap" type="button" class="cursor-pointer rounded-full border-none bg-[#7d5cf5] px-4 py-2 font-heading text-[13px] font-extrabold text-white">Use a character instead</button>
    <button id="gs-photo-keep" type="button" class="cursor-pointer rounded-full border border-white/[.16] bg-transparent px-4 py-2 font-heading text-[13px] font-extrabold text-[#f4f2f8]">Keep my photo</button>
  </div>
  <div id="auth-noconfig" hidden class="mx-auto mt-3.5 max-w-[1320px] rounded-[14px] border border-iris/[.35] bg-iris/10 px-[18px] py-3 text-[13.5px] text-[#cbb8ff]">
    ⚙️ Cloud accounts aren't configured yet, add your Supabase keys to <code>web/.env</code> to enable logins &amp; public profiles.
  </div>

  <!-- ═══════════ EXPLORE VIEW ═══════════ -->
  <div id="view-explore" hidden={isProfilePage}>
    <section class="relative overflow-hidden border-b border-white/[.075]">
      <div class="relative mx-auto max-w-[1320px] px-7 pb-[46px] pt-[60px]">
        <div class="mb-3.5 text-[11.5px] uppercase tracking-[.16em] text-iris-2">Community</div>
        <h1 class="m-0 mb-3.5 max-w-[24ch] font-heading text-[clamp(34px,4.4vw,54px)] font-extrabold tracking-[-.035em]">Gacha Profiles</h1>
        <p class="m-0 mb-[30px] max-w-[56ch] text-[17px] text-[#f4f2f8]/[.62]">Optional, public, and completely separate from your private watchlist. Show off the accounts you've built and see what everyone else is running.</p>
        <div class="flex flex-wrap items-center gap-3">
          <button id="hero-create" type="button" class="cursor-pointer rounded-full border-none bg-[#7d5cf5] px-[22px] py-[13px] font-heading text-[15px] font-extrabold text-white">Create your profile</button>
          <span id="hero-stats" class="text-[13px] text-[#f4f2f8]/[.45]">Loading profiles…</span>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1320px] px-7 pb-20 pt-8">
      <div class="mb-7 flex flex-wrap items-center justify-between gap-4 border-b border-white/[.075] pb-4">
        <div id="gs-tabs" class="flex flex-wrap gap-1.5"></div>
        <div class="flex flex-wrap items-center gap-2.5">
          <select id="gs-region" title="Co-op is region-locked, so filter by server" class="h-10 cursor-pointer rounded-full border border-white/[.12] bg-white/5 px-3.5 text-sm text-[#f4f2f8] outline-none">
            <option value="all">Any region</option>
            <option value="na">America</option>
            <option value="eu">Europe</option>
            <option value="asia">Asia</option>
            <option value="tw">TW/HK/MO</option>
            <option value="cn">China</option>
          </select>
          <select id="gs-sort" title="Order the gallery" class="h-10 cursor-pointer rounded-full border border-white/[.12] bg-white/5 px-3.5 text-sm text-[#f4f2f8] outline-none">
            <option value="liked">Most liked</option>
            <option value="updated">Recently updated</option>
          </select>
        <div class="relative">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(244,242,248,.45)" stroke-width="2" class="absolute left-3 top-3"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <input id="gs-search" type="text" placeholder="Search players or characters…" class="h-10 w-[260px] rounded-full border border-white/[.12] bg-white/5 py-2.5 pl-[34px] pr-3.5 text-sm text-[#f4f2f8] outline-none" />
          </div>
        </div>
      </div>

      <div id="gallery" class="grid gap-[22px]" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))"></div>
      <div id="gallery-empty" hidden class="rounded-[26px] border border-dashed border-white/[.16] px-7 py-16 text-center">
        <h3 class="m-0 mb-2 font-heading text-[21px] font-extrabold">No profiles yet</h3>
        <p class="m-0 text-[14.5px] text-[#f4f2f8]/[.55]">Be the first, log in and build your showcase.</p>
      </div>
    </div>
  </div>

  <!-- ═══════════ PROFILE VIEW ═══════════ -->
  <!-- Empty on showcase.html (JS fills it). Pre-rendered on a per-profile page,
       then replaced by showcase.js once the live row arrives. -->
  <div id="view-profile" hidden={!isProfilePage}>
    {profile && <StaticProfile profile={profile} roster={roster} base={base} />}
  </div>

  <!-- ═══════════ EDITOR (logged in) ═══════════ -->
  <div id="gs-editor" hidden class="mx-auto max-w-[1320px] px-7 pb-[60px]">
    <section class="rounded-3xl border border-white/[.08] bg-white/[.035] px-[26px] pb-7 pt-[26px] backdrop-blur-md">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <h2 class="m-0 font-heading text-[22px] font-extrabold tracking-[-.02em]">Your showcase</h2>
        <a id="gs-yourlink" href="#" target="_blank" rel="noopener" hidden class="text-[13px] font-semibold text-iris-2">· your link ↗</a>
        <button id="gs-editclose" type="button" class="ml-auto cursor-pointer rounded-full border border-white/[.12] bg-transparent px-4 py-2 font-heading text-[13px] font-extrabold text-[#f4f2f8]">Done</button>
      </div>
      <p class="m-0 mb-[18px] text-[13.5px] text-[#f4f2f8]/[.55]">Add a game with its rank, UID and characters, then hit <b class="text-iris-2">Add to showcase</b>. Repeat for every game you play, and use <b class="text-iris-2">✎</b> on a card to add more characters later. Changes save automatically.</p>

      <form id="gs-form" class="gs-form">
        <input id="gs-name" class="gs-in gs-wide" type="text" placeholder="Your display name (optional)" />

        <div class="gs-grid">
          <select id="gs-game" class="gs-in">
            <option value="wuwa">Wuthering Waves</option>
            <option value="hsr">Honkai: Star Rail</option>
            <option value="zzz">Zenless Zone Zero</option>
            <option value="pgr">Punishing: Gray Raven</option>
            <option value="genshin">Genshin Impact</option>
            <option value="custom">Other…</option>
          </select>
          <input id="gs-custom" class="gs-in" type="text" placeholder="Custom game name" hidden />
          <input id="gs-rank" class="gs-in" type="text" placeholder="Rank / level (e.g. 70)" />
          <input id="gs-ign" class="gs-in" type="text" placeholder="In-game name" />
          <input id="gs-uid" class="gs-in" type="text" placeholder="UID" />
        </div>

        <div class="gs-charpick gs-wide">
          <div id="gs-charchips" class="gs-charchips"></div>
          <div class="gs-charsearch">
            <input id="gs-charinput" class="gs-in" type="text" autocomplete="off"
              placeholder="Add favorite characters, type to search…" />
            <div id="gs-charmenu" class="gs-charmenu" hidden></div>
          </div>
        </div>
        <input id="gs-chars" type="hidden" />

        <input id="gs-note" class="gs-in gs-wide" type="text"
          placeholder="Short note / tagline (optional), e.g. day-one player" />

        <div class="gs-form-actions">
          <button type="button" id="gs-cancel" class="btn btn-github" hidden>Cancel</button>
          <button type="submit" id="gs-add" class="btn btn-primary">＋ Add to showcase</button>
        </div>
      </form>

      <div id="gs-cards" class="gs-cards mt-[22px]"></div>
      <div id="gs-empty" class="gs-empty" hidden></div>

      <div id="gs-cover" class="mt-6 border-t border-white/[.075] pt-5"></div>

      <!-- profile picture: character portrait by default, real photo only on request -->
      <div class="mt-6 border-t border-white/[.075] pt-5">
        <div class="mb-2 font-heading text-[16px] font-extrabold">Profile picture</div>
        <p class="m-0 mb-3 text-[12.5px] text-[#f4f2f8]/50">
          Your showcase uses your first cover character. You can use the photo from the account you
          signed in with instead — remember your profile is public and anyone can view it.
        </p>
        <label class="flex cursor-pointer items-center gap-2.5 text-[13.5px]">
          <input id="gs-usephoto" type="checkbox" class="h-4 w-4 accent-[#7d5cf5]" />
          <span>Use my account photo as my profile picture</span>
        </label>
        <div id="gs-photo-status" class="mt-2 text-[12.5px] text-[#f4f2f8]/45" hidden></div>
      </div>

      <!-- search indexing: off unless the owner asks for it -->
      <div id="gs-search-opt" class="mt-6 border-t border-white/[.075] pt-5" hidden>
        <div class="mb-2 font-heading text-[16px] font-extrabold">Search engines</div>
        <p class="m-0 mb-3 text-[12.5px] text-[#f4f2f8]/50">
          Your showcase page is public either way, and links to it still preview properly in Discord.
          This only controls whether Google may list it — which would make your UIDs and in-game names
          searchable and cached for a long time. Off unless you switch it on.
        </p>
        <label class="flex cursor-pointer items-center gap-2.5 text-[13.5px]">
          <input id="gs-searchable" type="checkbox" class="h-4 w-4 accent-[#7d5cf5]" />
          <span>List my showcase in search results</span>
        </label>
        <div id="gs-search-status" class="mt-2 text-[12.5px] text-[#f4f2f8]/45" hidden></div>
      </div>

      <div class="mt-6 flex items-center gap-3.5 border-t border-white/[.075] pt-5">
        <button type="button" id="gs-save" class="btn btn-primary px-[26px] py-[13px] text-[15px]">Save showcase</button>
        <span id="gs-savestatus" class="text-[13px] text-[#f4f2f8]/[.55]"></span>
      </div>
    </section>
  </div>

  <!-- logged in but no username yet — shown as a modal -->
  <div id="gs-setupname" class="am-overlay" hidden>
    <div class="am-card">
      <button class="am-x" id="gs-setup-close" type="button" aria-label="Close">✕</button>
      <h2 class="am-title">Confirm your username</h2>
      <p class="mb-6 text-center text-sm text-muted">We picked one from your Google name — keep it or change it. It becomes your public link, so anyone can find your showcase.</p>
      <form id="gs-setupform" class="am-form">
        <label class="am-label" for="gs-setup-uname">Username</label>
        <input id="gs-setup-uname" class="am-in" type="text" placeholder="yourname"
          maxlength="20" autocomplete="off" />
        <div id="gs-setup-status" class="gs-uname-status" hidden></div>
        <button class="am-submit" type="submit" id="gs-setup-save">Save username</button>
      </form>
    </div>
  </div>

  <Footer />
</div>
