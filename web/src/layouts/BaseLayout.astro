---
import '../styles/tailwind.css';
import '../styles/global.css';

const {
  title,
  description = '',
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
  page = 'default',
  chrome = true,
} = Astro.props;

// base always ends with a single trailing slash, e.g. "/OtakuList/"
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const site = 'https://shabanmughal.github.io';
const ogImageUrl = ogImage ? site + base + ogImage : undefined;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="author" content="OtakuList" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#8b5cf6" />

  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="t4Wj72z0rx1qMFt605unvuYsCxh4FZ0ZK2i9aYevERw" />

  {canonical && <link rel="canonical" href={canonical} />}

  {ogTitle && <meta property="og:type" content="website" />}
  {ogTitle && <meta property="og:site_name" content="OtakuList" />}
  {ogTitle && <meta property="og:title" content={ogTitle} />}
  {ogDescription && <meta property="og:description" content={ogDescription} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

  {ogTitle && <meta name="twitter:card" content="summary_large_image" />}
  {ogTitle && <meta name="twitter:title" content={ogTitle} />}
  {ogDescription && <meta name="twitter:description" content={ogDescription} />}
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

  <link rel="icon" href={`${base}assets/icon128.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600;700;800&family=Poppins:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
  <slot name="head" />
</head>

<body>
  {chrome && (
  <>
  <div class="bg-glows" aria-hidden="true">
    <span class="glow glow-1"></span>
    <span class="glow glow-2"></span>
    <span class="glow glow-3"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>

  <!-- shared nav -->
  <header class="nav" id="nav">
    <a class="brand" href={base}>
      <img src={`${base}assets/icon128.png`} alt="" class="brand-logo" />
      <span>OtakuList</span>
    </a>
    <nav class="nav-links">
      <a href={`${base}#features`}>Features</a>
      <a href={`${base}animelist.html`}>Create list</a>
      <a href={`${base}import.html`}>Import tool</a>
      <a href={`${base}showcase.html`}>Showcase</a>
      <a href={`${base}#faq`}>FAQ</a>
    </nav>
    <div class="nav-actions">
      {page === 'showcase' ? (
        <>
          <button id="nav-login" class="btn btn-primary btn-sm" type="button" hidden>Log in</button>
          <span id="nav-account" class="nav-account" hidden>
            <a id="nav-mylink" class="nav-username" href="#">@you</a>
            <button id="nav-logout" class="btn btn-github btn-sm" type="button">Log out</button>
          </span>
        </>
      ) : (
        <>
          <a
            href="https://github.com/ShabanMughal/OtakuList"
            target="_blank"
            rel="noopener"
            class="btn btn-github btn-sm"
            aria-label="Star OtakuList on GitHub"
          >
            <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z" />
            </svg>
            Star
          </a>
          <a href={`${base}#install`} class="btn btn-primary btn-sm">Add to Chrome</a>
        </>
      )}
    </div>
  </header>
  </>
  )}

  <slot />

  {chrome && (
  <!-- shared footer -->
  <footer class="footer">
    <div class="foot-brand">
      <img src={`${base}assets/icon128.png`} alt="" />
      <span>OtakuList</span>
    </div>
    <p>Made for anime &amp; gacha fans. Your list, kept safe.</p>
    <p class="foot-fine">Not affiliated with any anime studio or streaming site. Character art for personal use.</p>
  </footer>
  )}

  {chrome && <script is:inline src={`${base}js/script.js`}></script>}
  <slot name="scripts" />
</body>

</html>
