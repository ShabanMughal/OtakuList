---
import '../styles/redesign.css';

const {
  title,
  description = '',
  canonical,
  ogTitle,
  ogDescription,
  ogImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const site = 'https://shabanmughal.github.io';
const ogImageUrl = ogImage ? site + base + ogImage : undefined;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <meta name="author" content="OtakuList" />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#7d5cf5" />

  <meta name="google-site-verification" content="t4Wj72z0rx1qMFt605unvuYsCxh4FZ0ZK2i9aYevERw" />

  {canonical && <link rel="canonical" href={canonical} />}
  {ogTitle && <meta property="og:type" content="website" />}
  {ogTitle && <meta property="og:site_name" content="OtakuList" />}
  {ogTitle && <meta property="og:title" content={ogTitle} />}
  {ogDescription && <meta property="og:description" content={ogDescription} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
  {ogTitle && <meta name="twitter:card" content="summary_large_image" />}
  {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

  <link rel="icon" href={`${base}assets/gojo.png`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <slot name="head" />
</head>

<body>
  <slot />
  <slot name="scripts" />
</body>

</html>
