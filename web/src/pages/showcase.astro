---
import BaseLayout from '../layouts/BaseLayout.astro';
import ShowcaseApp from '../components/ShowcaseApp.astro';
import ShowcaseScripts from '../components/ShowcaseScripts.astro';
import { loadRoster } from '../lib/profiles.mjs';

// The gallery, and `?u=name` for every profile link shared before per-profile
// pages existed. Those links must keep working exactly as they do today —
// showcase.js still reads the query string and renders the profile client-side.
// New links point at u/<name>.html instead (see publicUrl in showcase.js).
const roster = loadRoster();
---

<BaseLayout
  title="Gacha Profiles, show off the games you play"
  description="Browse and build shareable showcases of the gacha games people play, Wuthering Waves, Honkai: Star Rail, Zenless Zone Zero, Genshin and more."
  canonical="https://shabanmughal.github.io/OtakuList/showcase.html"
  page="showcase"
  chrome={false}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />

  <ShowcaseApp roster={roster} />

  <Fragment slot="scripts">
    <ShowcaseScripts />
  </Fragment>
</BaseLayout>
