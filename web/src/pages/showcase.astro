---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
// read at build time from .env (PUBLIC_ vars), injected into the page below
const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const REPO = 'https://github.com/ShabanMughal/OtakuList';

// modernist theme tokens, scoped to this page's wrapper
const theme =
  "--color-bg:#0b0a16;--color-surface:#17142a;--color-text:#f4f2f8;" +
  "--color-accent:#7d5cf5;--color-accent-2:#6fa8dc;--color-accent-600:#6b4be0;" +
  "--color-divider:rgba(255,255,255,.12);--glass-line:rgba(255,255,255,.08);" +
  "--shadow-md:0 8px 24px rgba(0,0,0,.45);--shadow-lg:0 26px 60px rgba(0,0,0,.6);" +
  "--font-heading:'Archivo',system-ui,sans-serif;--font-body:'Poppins',system-ui,sans-serif;" +
  "--font-display:'Archivo',system-ui,sans-serif;" +
  "min-height:100vh;background:var(--color-bg);color:var(--color-text);font-family:var(--font-body)";
---

<BaseLayout
  title="Gacha Profiles, show off the games you play"
  description="Browse and build shareable showcases of the gacha games people play, Wuthering Waves, Honkai: Star Rail, Zenless Zone Zero, Genshin and more."
  canonical="https://shabanmughal.github.io/OtakuList/showcase.html"
  page="showcase"
  chrome={false}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800&display=swap"
    rel="stylesheet"
  />

  <div style={theme}>
    <!-- ═══════════ header ═══════════ -->
    <header class="sticky top-0 z-[60] border-b border-white/[.075] backdrop-blur-lg" style="background:rgba(11,10,22,.85)">
      <div class="mx-auto flex max-w-[1320px] flex-wrap items-center gap-[26px] px-7 py-3">
        <a href={base} class="flex items-center gap-2.5 text-[#f4f2f8]">
          <span class="grid h-[34px] w-[34px] flex-none place-items-center rounded-full border border-white/[.14] bg-[#191531]"><img src={`${base}assets/gojo.png`} alt="OtakuList" class="block h-[30px] w-[30px] rounded-full object-cover" /></span>
          <span class="font-heading text-[19px] font-extrabold tracking-[-.02em]">OtakuList</span>
        </a>
        <nav class="flex gap-[22px] text-[13.5px] font-semibold text-[#f4f2f8]/[.68]">
          <a href={`${base}#features`} class="text-inherit hover:text-iris-2">Features</a>
          <a href={`${base}#how`} class="text-inherit hover:text-iris-2">How it works</a>
          <a href={`${base}animelist.html`} class="text-inherit hover:text-iris-2">Create list</a>
          <a href={`${base}import.html`} class="text-inherit hover:text-iris-2">Import</a>
          <a href={`${base}showcase.html`} class="border-b-2 border-iris pb-0.5 text-iris-2">Gacha Profiles</a>
        </nav>
        <div class="ml-auto flex items-center gap-2.5">
          <a href={REPO} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-white/[.12] px-[18px] py-2.5 font-heading text-sm font-extrabold text-[#f4f2f8]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
            Star
          </a>
          <button id="nav-login" type="button" hidden class="cursor-pointer rounded-full border border-accent bg-accent px-5 py-2.5 font-heading text-sm font-extrabold text-white">Log in</button>
          <span id="nav-account" hidden class="flex items-center gap-3">
            <img id="nav-avatar" hidden alt="" referrerpolicy="no-referrer" class="h-8 w-8 rounded-full border border-white/20 object-cover" />
            <a id="nav-mylink" href="#" class="text-[13.5px] font-semibold text-iris-2">@you</a>
            <button id="nav-logout" type="button" class="cursor-pointer rounded-full border border-white/[.12] bg-transparent px-[18px] py-2.5 font-heading text-sm font-extrabold text-[#f4f2f8]">Log out</button>
          </span>
        </div>
      </div>
    </header>

    <div id="auth-msg" class="gs-auth-msg mx-auto mt-3.5 max-w-[1320px] px-7" hidden></div>
    <div id="auth-noconfig" hidden class="mx-auto mt-3.5 max-w-[1320px] rounded-[14px] border border-iris/[.35] bg-iris/10 px-[18px] py-3 text-[13.5px] text-[#cbb8ff]">
      ⚙️ Cloud accounts aren't configured yet, add your Supabase keys to <code>web/.env</code> to enable logins &amp; public profiles.
    </div>

    <!-- ═══════════ EXPLORE VIEW ═══════════ -->
    <div id="view-explore">
      <section class="relative overflow-hidden border-b border-white/[.075]">
        <div class="relative mx-auto max-w-[1320px] px-7 pb-[46px] pt-[60px]">
          <div class="mb-3.5 text-[11.5px] uppercase tracking-[.16em] text-iris-2">Community</div>
          <h1 class="m-0 mb-3.5 max-w-[24ch] font-heading text-[clamp(34px,4.4vw,54px)] font-extrabold tracking-[-.035em]">Gacha Profiles</h1>
          <p class="m-0 mb-[30px] max-w-[56ch] text-[17px] text-[#f4f2f8]/[.62]">Optional, public, and completely separate from your private watchlist. Show off the accounts you've built and see what everyone else is running.</p>
          <div class="flex flex-wrap items-center gap-3">
            <button id="hero-create" type="button" class="cursor-pointer rounded-full border-none bg-[#7d5cf5] px-[22px] py-[13px] font-heading text-[15px] font-extrabold text-white">Create your profile</button>
            <span id="hero-stats" class="text-[13px] text-[#f4f2f8]/[.45]">Loading profiles…</span>
          </div>
        </div>
      </section>

      <div class="mx-auto max-w-[1320px] px-7 pb-20 pt-8">
        <div class="mb-7 flex flex-wrap items-center justify-between gap-4 border-b border-white/[.075] pb-4">
          <div id="gs-tabs" class="flex flex-wrap gap-1.5"></div>
          <div class="relative">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="rgba(244,242,248,.45)" stroke-width="2" class="absolute left-3 top-3"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
            <input id="gs-search" type="text" placeholder="Search players or characters…" class="h-10 w-[260px] rounded-full border border-white/[.12] bg-white/5 py-2.5 pl-[34px] pr-3.5 text-sm text-[#f4f2f8] outline-none" />
          </div>
        </div>

        <div id="gallery" class="grid gap-[22px]" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))"></div>
        <div id="gallery-empty" hidden class="rounded-[26px] border border-dashed border-white/[.16] px-7 py-16 text-center">
          <h3 class="m-0 mb-2 font-heading text-[21px] font-extrabold">No profiles yet</h3>
          <p class="m-0 text-[14.5px] text-[#f4f2f8]/[.55]">Be the first, log in and build your showcase.</p>
        </div>
      </div>
    </div>

    <!-- ═══════════ PROFILE VIEW (JS-rendered) ═══════════ -->
    <div id="view-profile" hidden></div>

    <!-- ═══════════ EDITOR (logged in) ═══════════ -->
    <div id="gs-editor" hidden class="mx-auto max-w-[1320px] px-7 pb-[60px]">
      <section class="rounded-3xl border border-white/[.08] bg-white/[.035] px-[26px] pb-7 pt-[26px] backdrop-blur-md">
        <div class="mb-5 flex flex-wrap items-center gap-3">
          <h2 class="m-0 font-heading text-[22px] font-extrabold tracking-[-.02em]">Your showcase</h2>
          <a id="gs-yourlink" href="#" target="_blank" rel="noopener" hidden class="text-[13px] font-semibold text-iris-2">· your link ↗</a>
          <button id="gs-editclose" type="button" class="ml-auto cursor-pointer rounded-full border border-white/[.12] bg-transparent px-4 py-2 font-heading text-[13px] font-extrabold text-[#f4f2f8]">Done</button>
        </div>
        <p class="m-0 mb-[18px] text-[13.5px] text-[#f4f2f8]/[.55]">Add a game with its rank, UID and characters, then hit <b class="text-iris-2">Add to showcase</b>. Repeat for every game you play, and use <b class="text-iris-2">✎</b> on a card to add more characters later. Changes save automatically.</p>

        <form id="gs-form" class="gs-form">
          <input id="gs-name" class="gs-in gs-wide" type="text" placeholder="Your display name (optional)" />

          <div class="gs-grid">
            <select id="gs-game" class="gs-in">
              <option value="wuwa">Wuthering Waves</option>
              <option value="hsr">Honkai: Star Rail</option>
              <option value="zzz">Zenless Zone Zero</option>
              <option value="genshin">Genshin Impact</option>
              <option value="custom">Other…</option>
            </select>
            <input id="gs-custom" class="gs-in" type="text" placeholder="Custom game name" hidden />
            <input id="gs-rank" class="gs-in" type="text" placeholder="Rank / level (e.g. 70)" />
            <input id="gs-ign" class="gs-in" type="text" placeholder="In-game name" />
            <input id="gs-uid" class="gs-in" type="text" placeholder="UID" />
          </div>

          <div class="gs-charpick gs-wide">
            <div id="gs-charchips" class="gs-charchips"></div>
            <div class="gs-charsearch">
              <input id="gs-charinput" class="gs-in" type="text" autocomplete="off"
                placeholder="Add favorite characters, type to search…" />
              <div id="gs-charmenu" class="gs-charmenu" hidden></div>
            </div>
          </div>
          <input id="gs-chars" type="hidden" />

          <input id="gs-note" class="gs-in gs-wide" type="text"
            placeholder="Short note / tagline (optional), e.g. day-one player" />

          <div class="gs-form-actions">
            <button type="button" id="gs-cancel" class="btn btn-github" hidden>Cancel</button>
            <button type="submit" id="gs-add" class="btn btn-primary">＋ Add to showcase</button>
          </div>
        </form>

        <div id="gs-cards" class="gs-cards mt-[22px]"></div>
        <div id="gs-empty" class="gs-empty" hidden></div>

        <div id="gs-cover" class="mt-6 border-t border-white/[.075] pt-5"></div>

        <div class="mt-6 flex items-center gap-3.5 border-t border-white/[.075] pt-5">
          <button type="button" id="gs-save" class="btn btn-primary px-[26px] py-[13px] text-[15px]">Save showcase</button>
          <span id="gs-savestatus" class="text-[13px] text-[#f4f2f8]/[.55]"></span>
        </div>
      </section>
    </div>

    <!-- logged in but no username yet — shown as a modal -->
    <div id="gs-setupname" class="am-overlay" hidden>
      <div class="am-card">
        <button class="am-x" id="gs-setup-close" type="button" aria-label="Close">✕</button>
        <h2 class="am-title">Confirm your username</h2>
        <p class="mb-6 text-center text-sm text-muted">We picked one from your Google name — keep it or change it. It becomes your public link, so anyone can find your showcase.</p>
        <form id="gs-setupform" class="am-form">
          <label class="am-label" for="gs-setup-uname">Username</label>
          <input id="gs-setup-uname" class="am-in" type="text" placeholder="yourname"
            maxlength="20" autocomplete="off" />
          <div id="gs-setup-status" class="gs-uname-status" hidden></div>
          <button class="am-submit" type="submit" id="gs-setup-save">Save username</button>
        </form>
      </div>
    </div>

    <Footer />

    <!-- ═══════════ AUTH MODAL ═══════════ -->
    <div id="auth-modal" class="am-overlay" hidden>
      <div class="am-card">
        <button class="am-x" id="am-close" type="button" aria-label="Close">✕</button>
        <h2 class="am-title" id="am-title">Welcome back!</h2>

        <button id="am-google" type="button"
          class="mb-4 flex w-full cursor-pointer items-center justify-center gap-2.5 rounded-xl border border-white/[.16] bg-white px-3.5 py-3 font-heading text-[14.5px] font-bold text-[#1f1f1f] transition hover:bg-white/90">
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.5 0 10.5-2.1 14.3-5.5l-6.6-5.6C29.7 34.6 27 35.5 24 35.5c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.2 4.2-4.1 5.6l6.6 5.6C41.4 36 44 30.5 44 24c0-1.3-.1-2.3-.4-3.5z"/></svg>
          Continue with Google
        </button>

        <div id="am-or" class="mb-3.5 flex items-center gap-3 text-xs text-[#f4f2f8]/40" style="display:none">
          <span class="h-px flex-1 bg-white/[.12]"></span>or with email<span class="h-px flex-1 bg-white/[.12]"></span>
        </div>

        <form id="auth-form" class="am-form" style="display:none">
          <div id="am-uwrap" hidden>
            <label class="am-label" for="am-username">Username</label>
            <input id="am-username" class="am-in" type="text" placeholder="yourname" maxlength="20" autocomplete="off" />
            <div id="am-ustatus" class="gs-uname-status" hidden></div>
          </div>

          <label class="am-label" for="am-email">Email address</label>
          <input id="am-email" class="am-in" type="email" placeholder="name@email.com" autocomplete="email" required />

          <label class="am-label" for="am-pass">Password</label>
          <input id="am-pass" class="am-in" type="password" placeholder="Password" autocomplete="current-password" required />

          <div class="am-row" id="am-loginrow">
            <label class="am-remember"><input type="checkbox" id="am-remember" checked /> Remember me</label>
            <button type="button" class="am-forgot" id="am-forgot">Forgot password?</button>
          </div>

          <div id="am-err" class="am-err" hidden></div>
          <button type="submit" id="am-submit" class="am-submit">Login</button>
        </form>

        <p class="am-switch" style="display:none">
          <span id="am-switch-text">Don't have an account?</span>
          <button type="button" class="am-link" id="am-toggle">Register</button>
        </p>
      </div>
    </div>
  </div>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
      window.sb =
        window.supabase && SUPABASE_URL && SUPABASE_ANON_KEY
          ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY)
          : null;
    </script>
    <script is:inline src={`${base}js/showcase.js`}></script>
  </Fragment>
</BaseLayout>
