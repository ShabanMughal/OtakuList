---
import SiteLayout from '../layouts/SiteLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const REPO = 'https://github.com/ShabanMughal/OtakuList';
---

<SiteLayout
  title="OtakuList, Anime Watchlist Tracker for Chrome, Edge & Brave"
  description="OtakuList detects the anime and episode you're watching on any streaming site and saves it in your own browser, so your list survives even when a site gets blocked."
  canonical="https://shabanmughal.github.io/OtakuList/"
  ogTitle="OtakuList, Anime Watchlist Tracker"
  ogDescription="Your watchlist survives when the site doesn't. Auto-detects anime + episode, stored locally. Free & open source."
  ogImage="assets/og-image.png"
>
  <div style="min-height:100vh;background:var(--color-bg);color:var(--color-text)">

    <header style="position:sticky;top:0;z-index:60;background:rgba(11,10,22,.82);backdrop-filter:blur(16px);border-bottom:1px solid rgba(255,255,255,.075)">
      <div style="max-width:1240px;margin:0 auto;padding:12px 28px;display:flex;align-items:center;gap:26px;flex-wrap:wrap">
        <a href={base} style="display:flex;align-items:center;gap:10px;color:var(--color-text)">
          <span style="width:34px;height:34px;flex:none;border-radius:50%;display:grid;place-items:center;background:#191531;border:1px solid rgba(255,255,255,.14);"><img src={`${base}assets/gojo.png`} alt="OtakuList" style="width:30px;height:30px;border-radius:50%;object-fit:cover;display:block" /></span>
          <span style="font-family:var(--font-heading);font-weight:800;font-size:19px;letter-spacing:-.02em">OtakuList</span>
        </a>
        <nav class="rd-nav" style="display:flex;gap:22px;font-size:13.5px;font-weight:600">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href={`${base}animelist.html`}>Anime List</a>
          <a href={`${base}showcase.html`}>Gacha Profiles</a>
        </nav>
        <div style="margin-left:auto;display:flex;align-items:center;gap:10px">
          <a href={REPO} target="_blank" rel="noopener" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02 0 2.04.14 3 .41 2.28-1.55 3.29-1.23 3.29-1.23.66 1.65.24 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.22.7.83.58C20.56 22.29 24 17.79 24 12.5 24 5.87 18.63.5 12 .5z"/></svg>
            Star
          </a>
          <a href="#install" class="btn btn-primary" style="padding-inline:20px">Add to Chrome</a>
        </div>
      </div>
    </header>

    <section style="position:relative;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.075)">
      <div class="hero-glow" aria-hidden="true"></div>
      <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:80px 80px;mask-image:linear-gradient(to bottom,#000,transparent 85%);pointer-events:none"></div>
      <div style="position:relative;max-width:1240px;margin:0 auto;padding:88px 28px 96px;display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:64px;align-items:center">
        <div>
          <div style="display:inline-flex;align-items:center;gap:9px;padding:7px 14px;border-radius:999px;border:1px solid rgba(125,92,245,.45);background:rgba(125,92,245,.12);font-size:11.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#b9a8ff;margin-bottom:26px">
            <span style="width:6px;height:6px;background:#6fa8dc;animation:pulseRing 2s ease-in-out infinite"></span>
            Free · Open source · No account
          </div>
          <h1 style="font-size:clamp(40px,5.4vw,68px);line-height:1.02;letter-spacing:-.035em;margin:0 0 22px;text-wrap:balance">
            Your watchlist survives<br><span style="color:#b9a8ff">when the site doesn't.</span>
          </h1>
          <p style="font-size:18px;line-height:1.6;color:rgba(244,242,248,.66);max-width:52ch;margin:0 0 34px">
            OtakuList detects the anime and episode you're watching on any streaming site and saves it in your own browser. Mirror gets blocked, domain gets seized, your list and history are still right there.
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center">
            <a href="#install" class="btn btn-primary" style="font-size:15px;padding:14px 22px">Add to Chrome, it's free</a>
            <a href={`${base}animelist.html`} class="btn btn-secondary" style="font-size:15px;padding:14px 20px">See the web app</a>
          </div>
          <div style="display:flex;gap:28px;margin-top:40px;padding-top:26px;border-top:1px solid rgba(255,255,255,.075);flex-wrap:wrap">
            <div><div style="font-family:var(--font-heading);font-weight:800;font-size:26px">0</div><div style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:rgba(244,242,248,.5)">Servers used</div></div>
            <div><div style="font-family:var(--font-heading);font-weight:800;font-size:26px">38k+</div><div style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:rgba(244,242,248,.5)">Episodes tracked</div></div>
            <div><div style="font-family:var(--font-heading);font-weight:800;font-size:26px">MIT</div><div style="font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:rgba(244,242,248,.5)">License</div></div>
          </div>
        </div>

        <div style="position:relative;justify-self:center;width:100%;max-width:410px;animation:floaty 7s ease-in-out infinite">
          <div class="gojo-aura" aria-hidden="true"></div>
          <div style="position:relative;z-index:1;font-family:'Poppins',-apple-system,BlinkMacSystemFont,sans-serif;background:#17141f;border:1px solid #3b3554;border-radius:16px;overflow:hidden;box-shadow:var(--shadow-lg)">

            <!-- header -->
            <div style="display:flex;align-items:center;gap:10px;padding:14px 16px 12px;background:linear-gradient(135deg,#221d38,#17141f);border-bottom:1px solid #3b3554">
              <span style="width:34px;height:34px;flex:none;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,#8b5cf6,#6366f1)"><img src={`${base}assets/character.png`} alt="" style="width:30px;height:30px;object-fit:contain;display:block" /></span>
              <div style="flex:1;min-width:0">
                <div style="font-size:15px;font-weight:700;letter-spacing:.2px">OtakuList</div>
                <div style="font-size:11px;color:#b0a9cf">Your anime watchlist, kept safe</div>
              </div>
              <span style="width:32px;height:32px;flex:none;border-radius:9px;display:grid;place-items:center;background:#2a2540;color:#f4f2ff;font-size:18px;line-height:1">＋</span>
            </div>

            <!-- tabs -->
            <div style="display:flex;gap:4px;padding:10px 12px 0">
              <span style="flex:1;display:inline-flex;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:600;padding:8px 5px;border-radius:8px;background:#2a2540;color:#fff">Watching <b style="min-width:16px;padding:0 4px;font-size:10px;line-height:16px;background:#8b5cf6;border-radius:20px;color:#fff">9</b></span>
              <span style="flex:1;display:inline-flex;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:600;padding:8px 5px;border-radius:8px;color:#b0a9cf">Plan <b style="min-width:16px;padding:0 4px;font-size:10px;line-height:16px;background:#3b3554;border-radius:20px;color:#f4f2ff">0</b></span>
              <span style="flex:1;display:inline-flex;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:600;padding:8px 5px;border-radius:8px;color:#b0a9cf">Completed <b style="min-width:16px;padding:0 4px;font-size:10px;line-height:16px;background:#3b3554;border-radius:20px;color:#f4f2ff">1</b></span>
              <span style="flex:1;display:inline-flex;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:600;padding:8px 5px;border-radius:8px;color:#b0a9cf">On Hold <b style="min-width:16px;padding:0 4px;font-size:10px;line-height:16px;background:#3b3554;border-radius:20px;color:#f4f2ff">0</b></span>
            </div>

            <!-- search + sort -->
            <div style="display:flex;gap:8px;margin:10px 12px 4px">
              <div style="flex:1;padding:9px 12px;border-radius:10px;border:1px solid #3b3554;background:#1e1b2e;font-size:13px;color:#7d769c">Search your list…</div>
              <div style="display:flex;align-items:center;gap:6px;padding:0 12px;border-radius:10px;border:1px solid #3b3554;background:#1e1b2e;font-size:12px;color:#b0a9cf">Recent <span style="opacity:.6">▾</span></div>
            </div>

            <!-- cards -->
            <div style="padding:8px 12px 12px;display:flex;flex-direction:column;gap:8px">
              <div style="padding:10px;background:#1e1b2e;border:1px solid #3b3554;border-radius:12px">
                <div style="display:flex;gap:10px">
                  <div style="width:46px;height:62px;flex:none;border-radius:8px;overflow:hidden;background:#2a2540"><img src={`${base}assets/cover-jjk.jpg`} alt="Jujutsu Kaisen" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
                  <div style="min-width:0;flex:1">
                    <div style="font-size:13px;font-weight:600;line-height:1.3">Jujutsu Kaisen</div>
                    <div style="font-size:11px;color:#a78bfa;margin-top:2px">aniwatch.to</div>
                    <div style="display:flex;align-items:center;gap:6px;margin-top:8px">
                      <span style="width:24px;height:24px;border-radius:7px;border:1px solid #3b3554;background:#2a2540;display:grid;place-items:center;font-size:14px">−</span>
                      <span style="font-size:12px">Ep <b style="color:#a78bfa">12</b> / 23</span>
                      <span style="width:24px;height:24px;border-radius:7px;border:1px solid #3b3554;background:#2a2540;display:grid;place-items:center;font-size:14px">＋</span>
                    </div>
                  </div>
                </div>
                <div style="margin-top:8px;font-size:15px;letter-spacing:1px;color:#fbbf24">★★★★★</div>
                <div style="display:flex;gap:6px;margin-top:8px;align-items:center">
                  <div style="flex:1;display:flex;justify-content:space-between;align-items:center;padding:5px 8px;border-radius:7px;background:#2a2540;border:1px solid #3b3554;font-size:11px;color:#f4f2ff">Watching <span style="opacity:.5">▾</span></div>
                  <span style="width:26px;height:26px;border-radius:7px;background:#2a2540;border:1px solid #3b3554;display:grid;place-items:center;color:#a78bfa;font-size:10px">▶</span>
                  <span style="width:26px;height:26px;border-radius:7px;background:#2a2540;border:1px solid #3b3554;display:grid;place-items:center;color:#b0a9cf;font-size:12px">✎</span>
                  <span style="width:26px;height:26px;border-radius:7px;display:grid;place-items:center;color:#b0a9cf;font-size:12px">🗑</span>
                </div>
              </div>

              <div style="padding:10px;background:#1e1b2e;border:1px solid #3b3554;border-radius:12px">
                <div style="display:flex;gap:10px">
                  <div style="width:46px;height:62px;flex:none;border-radius:8px;overflow:hidden;background:#2a2540"><img src={`${base}assets/cover-onepiece.jpg`} alt="One Piece" style="width:100%;height:100%;object-fit:cover;display:block" /></div>
                  <div style="min-width:0;flex:1">
                    <div style="font-size:13px;font-weight:600;line-height:1.3">One Piece</div>
                    <div style="font-size:11px;color:#a78bfa;margin-top:2px">gogoanime</div>
                    <div style="display:flex;align-items:center;gap:6px;margin-top:8px">
                      <span style="width:24px;height:24px;border-radius:7px;border:1px solid #3b3554;background:#2a2540;display:grid;place-items:center;font-size:14px">−</span>
                      <span style="font-size:12px">Ep <b style="color:#a78bfa">1088</b></span>
                      <span style="width:24px;height:24px;border-radius:7px;border:1px solid #3b3554;background:#2a2540;display:grid;place-items:center;font-size:14px">＋</span>
                    </div>
                  </div>
                </div>
                <div style="margin-top:8px;font-size:15px;letter-spacing:1px"><span style="color:#fbbf24">★★★★</span><span style="color:#3b3554">★</span></div>
                <div style="display:flex;gap:6px;margin-top:8px;align-items:center">
                  <div style="flex:1;display:flex;justify-content:space-between;align-items:center;padding:5px 8px;border-radius:7px;background:#2a2540;border:1px solid #3b3554;font-size:11px;color:#f4f2ff">Watching <span style="opacity:.5">▾</span></div>
                  <span style="width:26px;height:26px;border-radius:7px;background:#2a2540;border:1px solid #3b3554;display:grid;place-items:center;color:#a78bfa;font-size:10px">▶</span>
                  <span style="width:26px;height:26px;border-radius:7px;background:#2a2540;border:1px solid #3b3554;display:grid;place-items:center;color:#b0a9cf;font-size:12px">✎</span>
                  <span style="width:26px;height:26px;border-radius:7px;display:grid;place-items:center;color:#b0a9cf;font-size:12px">🗑</span>
                </div>
              </div>
            </div>

            <!-- footer -->
            <div style="padding:8px 16px;border-top:1px solid #3b3554;background:#1e1b2e;display:flex;align-items:center;justify-content:space-between">
              <span style="font-size:11px;color:#b0a9cf">10 titles saved</span>
              <div style="display:flex;gap:6px">
                <span style="font-size:11px;font-weight:600;padding:5px 12px;border-radius:7px;background:#8b5cf6;color:#fff">Export</span>
                <span style="font-size:11px;font-weight:600;padding:5px 12px;border-radius:7px;background:rgba(139,92,246,.18);border:1px solid #8b5cf6;color:#a78bfa">Import</span>
              </div>
            </div>
          </div>

          <div style="position:absolute;z-index:2;right:-18px;bottom:-24px;display:flex;align-items:center;gap:10px;font-family:'Poppins',-apple-system,BlinkMacSystemFont,sans-serif;background:#1e1b2e;color:#f4f2ff;border:1px solid #3b3554;border-radius:12px;padding:10px 14px 10px 10px;box-shadow:0 12px 32px rgba(0,0,0,.5);animation:slidein .8s ease-out both;animation-delay:.4s">
            <span style="width:28px;height:28px;flex:none;border-radius:8px;display:grid;place-items:center;background:linear-gradient(135deg,#8b5cf6,#6366f1)"><img src={`${base}assets/character.png`} alt="" style="width:24px;height:24px;object-fit:contain;display:block" /></span>
            <div style="font-size:12px;line-height:1.35">
              <b style="color:#a78bfa;font-weight:700">OtakuList</b><br />Updated to Episode <b style="color:#a78bfa;font-weight:700">3</b>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="sec" style="border-bottom:1px solid rgba(255,255,255,.075)">
      <div class="sec-glow gl-right" aria-hidden="true"></div>
      <div style="max-width:1240px;margin:0 auto;padding:84px 28px">
        <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:28px;flex-wrap:wrap;margin-bottom:44px">
          <div>
            <div style="font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:#b9a8ff;margin-bottom:14px">Features</div>
            <h2 style="font-size:clamp(30px,3.4vw,44px);letter-spacing:-.03em;margin:0">Built for people who watch<br>where the anime actually is.</h2>
          </div>
          <p style="max-width:34ch;color:rgba(244,242,248,.6);margin:0;font-size:15px">No sign-up wall, no sync server, no telemetry. Just a tracker that keeps working when everything else disappears.</p>
        </div>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px">
          <div class="rd-card" style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px 26px 32px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7d5cf5" stroke-width="2" stroke-linecap="round"><path d="M12 5c-5 0-9 4.5-10 7 1 2.5 5 7 10 7s9-4.5 10-7c-1-2.5-5-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            <h3 style="font-size:19px;margin:16px 0 8px;letter-spacing:-.02em">Auto-detects anime + episode</h3>
            <p style="margin:0;font-size:14.5px;color:rgba(244,242,248,.62)">Reads the page title and player state to figure out the show and the episode number. Works on the mirror you found yesterday.</p>
          </div>
          <div class="rd-card" style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px 26px 32px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7d5cf5" stroke-width="2" stroke-linecap="round"><rect x="4" y="10" width="16" height="11"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
            <h3 style="font-size:19px;margin:16px 0 8px;letter-spacing:-.02em">Local and private</h3>
            <p style="margin:0;font-size:14.5px;color:rgba(244,242,248,.62)">Everything lives in your browser's own storage. No account, no servers, nothing leaves the device, we couldn't read your list if we wanted to.</p>
          </div>
          <div class="rd-card" style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px 26px 32px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7d5cf5" stroke-width="2" stroke-linecap="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <h3 style="font-size:19px;margin:16px 0 8px;letter-spacing:-.02em">Survives site blocks</h3>
            <p style="margin:0;font-size:14.5px;color:rgba(244,242,248,.62)">Your progress is tied to the show, not the domain. When a site dies, move to the next one and pick up at the exact episode.</p>
          </div>
          <div class="rd-card" style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px 26px 32px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7d5cf5" stroke-width="2" stroke-linecap="round"><path d="M13 2L3 14h9l-1 8 10-12h-9z"/></svg>
            <h3 style="font-size:19px;margin:16px 0 8px;letter-spacing:-.02em">Silent episode tracking</h3>
            <p style="margin:0;font-size:14.5px;color:rgba(244,242,248,.62)">Confirm a show once. After that every new episode bumps the counter by itself, no popups mid-fight-scene.</p>
          </div>
          <div class="rd-card" style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px 26px 32px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7d5cf5" stroke-width="2" stroke-linecap="round"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M10.3 21a2 2 0 003.4 0"/></svg>
            <h3 style="font-size:19px;margin:16px 0 8px;letter-spacing:-.02em">Toolbar badge count</h3>
            <p style="margin:0;font-size:14.5px;color:rgba(244,242,248,.62)">A small number on the icon tells you how many shows are still in progress. One glance, no clicking.</p>
          </div>
          <div class="rd-card" style="background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.08);border-radius:20px;padding:30px 26px 32px">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7d5cf5" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
            <h3 style="font-size:19px;margin:16px 0 8px;letter-spacing:-.02em">Sorted lists</h3>
            <p style="margin:0;font-size:14.5px;color:rgba(244,242,248,.62)">Watching, Plan to Watch, Completed and On Hold, drop a show into a bucket and it stays organised for you.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="how" style="border-bottom:1px solid rgba(255,255,255,.075);background:linear-gradient(180deg,rgba(125,92,245,.06),transparent)">
      <div style="max-width:1240px;margin:0 auto;padding:84px 28px">
        <div style="font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:#b9a8ff;margin-bottom:14px">How it works</div>
        <h2 style="font-size:clamp(30px,3.4vw,44px);letter-spacing:-.03em;margin:0 0 46px;max-width:22ch">Three steps, and then you forget it exists.</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:34px">
          <div style="background:rgba(125,92,245,.1);border:1px solid rgba(125,92,245,.3);border-radius:22px;padding:26px 26px 28px">
            <div style="font-family:var(--font-heading);font-weight:800;font-size:52px;line-height:1;color:rgba(139,109,240,.85);margin-bottom:14px">01</div>
            <h3 style="font-size:21px;margin:0 0 10px;letter-spacing:-.02em">Watch normally</h3>
            <p style="margin:0;font-size:15px;color:rgba(244,242,248,.62)">Open whatever site you use. OtakuList sits quiet in the background and notices a player is running.</p>
          </div>
          <div style="background:rgba(125,92,245,.1);border:1px solid rgba(125,92,245,.3);border-radius:22px;padding:26px 26px 28px">
